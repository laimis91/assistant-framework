{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework-promotion-decision.schema.json",
  "title": "Assistant Framework Workflow Kernel Promotion Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_kind", "bindings", "automatic_behavioral_gates_passed", "trusted_execution_profile_passed", "semantic_false_positive_review", "failed_gates", "behavioral_promotion_eligible"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "decision_kind": {"const": "workflow_kernel_behavioral_promotion"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_manifest_sha256", "candidate_instruction_sha256", "context_budget_evidence_sha256", "review_packet_sha256", "semantic_verdict_sha256", "trace_set_sha256", "pair_sha256"],
      "properties": {
        "candidate_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_instruction_sha256": {"$ref": "#/$defs/sha256"},
        "context_budget_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "review_packet_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_verdict_sha256": {"$ref": "#/$defs/sha256"},
        "trace_set_sha256": {"$ref": "#/$defs/sha256"},
        "pair_sha256": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}
      }
    },
    "automatic_behavioral_gates_passed": {"type": "boolean"},
    "trusted_execution_profile_passed": {"type": "boolean"},
    "semantic_false_positive_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_pairs", "reviewed_candidate_findings"],
      "properties": {
        "status": {"enum": ["approved", "rejected"]},
        "reviewed_pairs": {"type": "integer", "minimum": 0},
        "reviewed_candidate_findings": {"type": "integer", "minimum": 0}
      }
    },
    "failed_gates": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["pilot_coverage_or_automatic_gates", "semantic_review_not_approved", "untrusted_execution_profile"]}
    },
    "behavioral_promotion_eligible": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"behavioral_promotion_eligible": {"const": true}}},
      "then": {
        "properties": {
          "automatic_behavioral_gates_passed": {"const": true},
          "trusted_execution_profile_passed": {"const": true},
          "semantic_false_positive_review": {"properties": {"status": {"const": "approved"}}},
          "failed_gates": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"behavioral_promotion_eligible": {"const": false}}},
      "then": {
        "anyOf": [
          {"properties": {"automatic_behavioral_gates_passed": {"const": false}}},
          {"properties": {"semantic_false_positive_review": {"properties": {"status": {"const": "rejected"}}}}},
          {"properties": {"trusted_execution_profile_passed": {"const": false}}}
        ]
      }
    },
    {
      "if": {"properties": {"automatic_behavioral_gates_passed": {"const": false}}},
      "then": {"properties": {"failed_gates": {"contains": {"const": "pilot_coverage_or_automatic_gates"}, "minContains": 1}}}
    },
    {
      "if": {"properties": {"semantic_false_positive_review": {"properties": {"status": {"const": "rejected"}}}}},
      "then": {"properties": {"failed_gates": {"contains": {"const": "semantic_review_not_approved"}, "minContains": 1}}}
    },
    {
      "if": {"properties": {"trusted_execution_profile_passed": {"const": false}}},
      "then": {"properties": {"failed_gates": {"contains": {"const": "untrusted_execution_profile"}, "minContains": 1}}}
    },
    {
      "if": {
        "properties": {
          "automatic_behavioral_gates_passed": {"const": true},
          "trusted_execution_profile_passed": {"const": true},
          "semantic_false_positive_review": {"properties": {"status": {"const": "approved"}}}
        }
      },
      "then": {
        "properties": {
          "behavioral_promotion_eligible": {"const": true},
          "failed_gates": {"maxItems": 0}
        }
      }
    }
  ]
}

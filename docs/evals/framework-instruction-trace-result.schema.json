{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework-instruction-trace-result.schema.json",
  "title": "Assistant Framework Instruction Trace Result",
  "description": "Provider-neutral, redacted measurements imported from one framework instruction eval run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "model",
    "variant",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "variant": {
      "type": "string",
      "enum": [
        "baseline",
        "candidate"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "adapter_unavailable"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "latency_ms",
        "tool_calls",
        "unnecessary_questions",
        "time_to_first_useful_action_ms",
        "rework_count",
        "acceptance_passed"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "unnecessary_questions": {
          "type": "integer",
          "minimum": 0
        },
        "time_to_first_useful_action_ms": {
          "type": "number",
          "minimum": 0
        },
        "rework_count": {
          "type": "integer",
          "minimum": 0
        },
        "acceptance_passed": {
          "type": "boolean"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "metrics"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "adapter_unavailable"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "not": {
          "required": [
            "metrics"
          ]
        }
      }
    }
  ]
}
